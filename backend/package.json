{
  "name": "swapcampus-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest --runInBand",
    "prisma:generate": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate",
    "db:push": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:init": "tsx prisma/init.ts",
    "db:sync-default-accounts": "tsx prisma/sync-default-accounts.ts",
    "db:ensure-category-products": "tsx prisma/ensure-category-products.ts",
    "db:ensure-campus-services": "tsx prisma/ensure-campus-services.ts",
    "db:verify-category-products": "tsx prisma/verify-category-products.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
