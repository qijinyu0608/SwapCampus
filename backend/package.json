{
  "name": "swapcampus-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest --runInBand",
    "prisma:generate": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate",
    "db:push": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma db push",
    "db:init": "tsx prisma/init.ts",
    "db:remove-demo-data": "tsx prisma/remove-demo-data.ts",
    "db:seed-demo-data": "tsx prisma/seed-demo-data.ts",
    "db:reindex-products": "tsx prisma/reindex-products.ts",
    "db:migrate-product-statuses": "tsx prisma/migrate-product-statuses.ts",
    "db:generate-product-samples": "tsx prisma/generate-product-samples.ts",
    "db:migrate-product-categories": "tsx prisma/migrate-product-categories.ts",
    "db:clean-domain-data": "tsx prisma/clean-domain-data.ts",
    "db:verify-category-products": "tsx prisma/verify-category-products.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.17.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "meilisearch": "^0.58.0",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "segmentit": "^2.0.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "supertokens-node": "^24.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
