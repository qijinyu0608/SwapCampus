generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-arm64-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProductStatus {
  PENDING
  ON_SALE
  SOLD
  OFFLINE
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_REVIEW
  COMPLETED
  CANCELED
}

enum CampusServiceCategory {
  ERRAND
  AGENCY
  GROUP_BUY
  HELP
}

enum CampusServiceStatus {
  OPEN
  MATCHED
  DONE
  CANCELED
}

enum MessageType {
  TEXT
  IMAGE
  EMOJI
}

enum BehaviorEventType {
  VIEW
  FAVORITE
  UNFAVORITE
  CONTACT
  ORDER
}

model User {
  id           Int                   @id @default(autoincrement())
  studentId    String                @unique
  name         String
  email        String                @unique
  passwordHash String
  role         UserRole              @default(USER)
  creditScore  Int                   @default(60)
  isVerified   Boolean               @default(false)
  isBanned     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  verification StudentVerification?
  sentMessages Message[]
}

model StudentVerification {
  id        Int      @id @default(autoincrement())
  userId     Int     @unique
  realName  String
  college   String
  phone     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Product {
  id          Int           @id @default(autoincrement())
  sellerId     Int
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  category    String
  condition   String
  tags        String
  status      ProductStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId  Int
  imageUrl  String
  sortOrder Int    @default(0)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId     Int
  productId  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id             Int         @id @default(autoincrement())
  productId       Int
  buyerId         Int
  sellerId        Int
  status         OrderStatus @default(PENDING)
  meetupLocation String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  conversations  Conversation[]
}

model CampusServiceTask {
  id               Int                   @id @default(autoincrement())
  title            String
  category         CampusServiceCategory
  description      String
  reward           Decimal               @db.Decimal(10, 2)
  locationFrom     String
  locationTo       String
  deadlineLabel    String
  estimatedMinutes Int
  publisherId      Int
  accepterId       Int?
  status           CampusServiceStatus   @default(OPEN)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  conversations    Conversation[]
}

model Review {
  id         Int      @id @default(autoincrement())
  orderId      Int
  reviewerId   Int
  rating     Int
  content    String
  createdAt  DateTime @default(now())
}

model Conversation {
  id           Int       @id @default(autoincrement())
  orderId      Int?
  productId    Int?
  campusServiceTaskId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order?    @relation(fields: [orderId], references: [id])
  campusServiceTask CampusServiceTask? @relation(fields: [campusServiceTaskId], references: [id])
  messages     Message[]
}

model Message {
  id             Int           @id @default(autoincrement())
  conversationId Int
  senderId       Int
  type           MessageType   @default(TEXT)
  content        String
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])
}

model Report {
  id           Int      @id @default(autoincrement())
  reporterId     Int
  productId      Int?
  targetUserId   Int?
  reason       String
  status       String   @default("OPEN")
  resolutionNote String?
  handledBy      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorName  String
  action     String
  targetType String
  targetId   Int
  detail     String
  createdAt  DateTime @default(now())
}

model UserBehavior {
  id        Int               @id @default(autoincrement())
  userId    Int
  productId Int
  eventType BehaviorEventType
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([userId, productId, createdAt])
  @@index([productId, eventType])
}
