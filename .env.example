# Docker Compose deployment overrides
# Copy to .env before running `make init` / `make start`.

# Public access URLs
API_DOMAIN=http://127.0.0.1:3001
WEBSITE_DOMAIN=http://127.0.0.1:5178

# Frontend build-time API endpoints
VITE_API_BASE_URL=http://127.0.0.1:3001/api
VITE_API_DOMAIN=http://127.0.0.1:3001
VITE_SOCKET_URL=http://127.0.0.1:3001
VITE_WEBSITE_DOMAIN=http://127.0.0.1:5178

# Backend runtime wiring
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
ENABLE_DEV_AUTH_FALLBACK=true
VENDURE_ENABLED=true
VENDURE_ADMIN_API_URL=http://vendure:3000/admin-api
VENDURE_ADMIN_USERNAME=superadmin
VENDURE_ADMIN_PASSWORD=superadmin
BACKEND_SEARCH_INDEX_OUTBOX_ENABLED=false
BACKEND_SEARCH_INDEXER_INITIALIZE_ON_STARTUP=false
BACKEND_COMMERCE_SYNC_ENABLED=false
BACKEND_MESSAGE_OUTBOX_ENABLED=true
BACKEND_RECOMMENDATION_OUTBOX_ENABLED=true
BACKEND_GOVERNANCE_OUTBOX_ENABLED=false
GOVERNANCE_MQ_ENABLED=true

# Worker runtime wiring
SEARCH_INDEX_OUTBOX_ENABLED=true
SEARCH_INDEXER_INITIALIZE_ON_STARTUP=true
SEARCH_INDEX_OUTBOX_POLL_MS=3000
SEARCH_INDEX_OUTBOX_BATCH_SIZE=20
SEARCH_INDEX_OUTBOX_PROCESSING_TIMEOUT_MS=120000
SEARCH_INDEX_OUTBOX_RETRY_DELAYS_MS=5000,15000,60000,300000,900000
COMMERCE_SYNC_ENABLED=true
COMMERCE_SYNC_OUTBOX_POLL_MS=3000
COMMERCE_SYNC_OUTBOX_BATCH_SIZE=20
COMMERCE_SYNC_OUTBOX_PROCESSING_TIMEOUT_MS=120000
COMMERCE_SYNC_OUTBOX_RETRY_DELAYS_MS=5000,15000,60000,300000,900000
MESSAGE_OUTBOX_ENABLED=true
MESSAGE_OUTBOX_POLL_MS=2000
MESSAGE_OUTBOX_BATCH_SIZE=20
MESSAGE_OUTBOX_PROCESSING_TIMEOUT_MS=60000
MESSAGE_OUTBOX_RETRY_DELAYS_MS=3000,10000,30000,120000
RECOMMENDATION_OUTBOX_ENABLED=true
RECOMMENDATION_OUTBOX_POLL_MS=2000
RECOMMENDATION_OUTBOX_BATCH_SIZE=30
RECOMMENDATION_OUTBOX_PROCESSING_TIMEOUT_MS=60000
RECOMMENDATION_OUTBOX_RETRY_DELAYS_MS=3000,10000,30000,120000
GOVERNANCE_OUTBOX_ENABLED=true
GOVERNANCE_OUTBOX_POLL_MS=2000
GOVERNANCE_OUTBOX_BATCH_SIZE=20
GOVERNANCE_OUTBOX_PROCESSING_TIMEOUT_MS=60000
GOVERNANCE_OUTBOX_RETRY_DELAYS_MS=3000,10000,30000,120000
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
GOVERNANCE_MQ_EXCHANGE=swapcampus.governance
GOVERNANCE_MQ_QUEUE=swapcampus.governance.audit
GOVERNANCE_MQ_ROUTING_KEY=governance.audit
GOVERNANCE_MQ_PREFETCH=20

# Optional backend feature switches / secrets
SUPERTOKENS_API_KEY=
VENDURE_ADMIN_TOKEN=

# Optional LLM moderation integration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
